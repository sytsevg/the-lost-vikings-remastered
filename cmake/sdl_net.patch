+// the-lost-vikings-remastered (co-op online): a stream socket that carries small messages at once. Nagle's
+// algorithm off (TCP_NODELAY), and on Linux acknowledgements sent at once (TCP_QUICKACK, which the kernel turns off
+// again: set after every read too). If either can't be set, the socket works as it would have.
+static void SetLowLatency(Socket handle)
+{
+    int one = 1;
+    setsockopt(handle, IPPROTO_TCP, TCP_NODELAY, (const char *) &one, sizeof (one));
+#ifdef TCP_QUICKACK
+    setsockopt(handle, IPPROTO_TCP, TCP_QUICKACK, (const char *) &one, sizeof (one));
+#endif
+}
